# EN-001: Variables de entorno para Eco-Vecino
# Copia este archivo como .env y configura tus valores reales

# === PostgreSQL ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eco_vecino

# === JWT (para SP-001 / HU-001) ===
SECRET_KEY=cambia_esto_por_una_clave_segura_generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Entorno ===
ENVIRONMENT=development
